# 9Router key used by the Droid custom-model settings.
NINEROUTER_API_KEY=

# Optional Droid model base URL. The default works with Docker Desktop on macOS.
DROID_MODEL_BASE_URL=http://host.docker.internal:20128/v1

# Optional for Droid. If empty, the adapter copies the host Droid login files.
FACTORY_API_KEY=

# Required for Amp Code. Create a headless access token at
# https://ampcode.com/settings/security. It starts with sgamp_.
AMP_API_KEY=

# Phoenix / Arize
# For Phoenix Cloud, use the workspace base URL through /s/<handle>.
# For local Phoenix, use http://localhost:6006 and leave the key empty.
PHOENIX_API_KEY=
PHOENIX_ENDPOINT=
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT=default

# Optional Phoenix/OpenTelemetry exporter headers. The Harbor plugin uses
# PHOENIX_API_KEY directly, so this is only needed by separate OTel exporters.
# OTEL_EXPORTER_OTLP_HEADERS=
